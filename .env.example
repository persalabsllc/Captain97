# Automatically provided when an Upstash Redis database is connected through Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# A long random secret shared only with StationPlaylist Studio.
STATIONPLAYLIST_UPDATE_TOKEN=

# Initial shared studio/monitoring login credential. Generate a 16-byte hex salt
# and its 64-byte scrypt hash; never store the plaintext password here.
STUDIO_INITIAL_PASSWORD_SALT=
STUDIO_INITIAL_PASSWORD_HASH=

# A separate 32+ character bearer token used by the outbound-only station agent.
MONITORING_INGEST_TOKEN=

# Optional public, CORS-enabled HTTPS audio feeds. Set the Barix confidence
# monitor only after confirming extra listeners cannot affect the STL path.
# The public Live365 stream is used when its override is absent.
MONITORING_STL_AUDIO_URL=
MONITORING_OFFAIR_AUDIO_URL=
MONITORING_STREAM_AUDIO_URL=

# Optional. Telemetry is considered stale after 30 seconds by default (10-300).
MONITORING_STALE_AFTER_SECONDS=30

# Optional private automation endpoint overrides. Captain 97's current
# dj.kd8hln.com audio and archive endpoints are the built-in defaults.
MONITORING_NEWS_LATEST_AUDIO_URL=
MONITORING_NEWS_ARCHIVE_URL=
MONITORING_NEWS_GENERATE_URL=
MONITORING_NEWS_GENERATE_TOKEN=
MONITORING_WEATHER_LATEST_AUDIO_URL=
MONITORING_WEATHER_ARCHIVE_URL=
MONITORING_WEATHER_GENERATE_URL=
MONITORING_WEATHER_GENERATE_TOKEN=
LIVE365_ANALYTICS_URL=https://dashboard.live365.com
# Comma-separated exact hostnames allowed for a custom Live365 analytics
# destination. The destination must enforce its own login and may not use
# secret-bearing query parameters.
MONITORING_CONTROL_ALLOWED_HOSTS=
# Comma-separated exact origins (including a nonstandard port) allowed for
# server-fetched automation content. Query strings are not accepted.
MONITORING_AUTOMATION_ALLOWED_ORIGINS=

# Server-only key from the dedicated Captain 97 Stripe account.
STRIPE_SECRET_KEY=

# Server-only Resend API key provisioned by the Vercel Marketplace integration.
RESEND_API_KEY=

# Optional override. The default is Captain 97 Website <website@captain97.com>.
CONTACT_FROM_EMAIL=
